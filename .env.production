# ---------------------------------------------------------------------------
# Production frontend config (Vite) — baked into `npm run build` on Vercel.
#
# Only VITE_* vars are exposed to the browser; none of these are secret.
# Vite loads this file for production builds, but any variable of the same
# name set in the Vercel dashboard (Project -> Settings -> Environment
# Variables) takes precedence over the value here — so the dashboard can
# override without editing the repo.
# ---------------------------------------------------------------------------

# Base URL of the deployed FastAPI backend, INCLUDING the /api/v1 suffix.
# This defaults to the Render service named `nir-backend` in render.yaml
# (Render serves it at https://<service-name>.onrender.com). If Render had to
# append a suffix because that name was taken, change ONLY this line to the
# real service URL and redeploy the frontend.
VITE_API_BASE_URL=https://nir-backend.onrender.com/api/v1

VITE_APP_NAME="Neighborhood Issue Reporter"

# Default Leaflet map view (Pakistan).
VITE_MAP_DEFAULT_LAT=30.3753
VITE_MAP_DEFAULT_LNG=69.3451
VITE_MAP_DEFAULT_ZOOM=5

# Keep OFF in production: real backend errors must surface (toast / error
# panel) instead of silently masking with localStorage demo data.
VITE_ENABLE_MOCK_FALLBACK=false

# Client-side error tracking (optional). Paste a browser DSN from a Sentry
# project to turn it on, or set it as a Vercel env var instead. Blank = off.
VITE_SENTRY_DSN=
