# ---------------------------------------------------------------------------
# Neighborhood Issue Reporter - backend environment configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust the values:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets or credentials.
# ---------------------------------------------------------------------------

# --- Application ----------------------------------------------------------
APP_NAME="Neighborhood Issue Reporter API"

# One of: local | development | test | staging | production
APP_ENV=local

# Enables verbose logging and the interactive docs. Turn OFF in production.
DEBUG=true

# Mount point for every versioned route. Must start with "/" and not end in "/".
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------------------
# Used to sign JWTs in Phase 2. Generate a fresh random value per environment:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application refuses to start in APP_ENV=production while this is the
# built-in placeholder value.
SECRET_KEY=replace-with-a-long-random-secret-value

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins, or a JSON array.
# "*" allows any origin and automatically disables credentialed requests,
# which is convenient locally but must be narrowed for production.
#   CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# --- Uploads (consumed by the report-photo module in a later phase) -------
# Relative paths are resolved against the `backend/` directory.
UPLOAD_DIR=uploads

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=5

# --- Database (MySQL 8) ---------------------------------------------------
# SQLAlchemy URL. Format:
#   mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#
# Replace the placeholders below with your real credentials. If the password
# contains @ : / or ?, percent-encode it (for example "p@ss" -> "p%40ss").
#
# Create the schema first:
#   CREATE DATABASE neighborhood_issues
#     CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Then apply the migrations:   alembic upgrade head
DATABASE_URL=mysql+pymysql://CHANGE_ME:CHANGE_ME@127.0.0.1:3306/neighborhood_issues

# Connection pool. DB_POOL_RECYCLE_SECONDS must stay below MySQL's
# wait_timeout (default 28800) so the pool never serves a dead connection.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# Log every SQL statement. Very noisy; local debugging only.
DB_ECHO=false

# --- Supabase -------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase API keys (Publishable / Anon key & Secret / Service Role key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Google AI (Gemini) ---------------------------------------------------
# API key from https://aistudio.google.com/apikey. Server-side only.
GEMINI_API_KEY=
# Model to call. gemini-flash-lite-latest is a stable fast/cheap alias.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google Maps / Geocoding ----------------------------------------------
# API key from the Google Cloud Console. Server-side only; restrict by API
# (e.g. Geocoding, Places) and by caller IP in production.
GOOGLE_MAPS_API_KEY=
