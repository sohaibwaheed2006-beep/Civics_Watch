# ---------------------------------------------------------------------------
# Neighborhood Issue Reporter - Environment Configuration (EXAMPLE)
#
# Copy this file to `.env` and adjust the values:
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real secrets or credentials.
# ---------------------------------------------------------------------------

# ===========================================================================
# BACKEND CONFIGURATION
# ===========================================================================

# --- Application ----------------------------------------------------------
APP_NAME="Neighborhood Issue Reporter API"

# One of: local | development | test | staging | production
APP_ENV=local

# Enables verbose logging and the interactive docs. Turn OFF in production.
DEBUG=true

# Mount point for every versioned route. Must start with "/" and not end in "/".
API_V1_PREFIX=/api/v1

# --- Security -------------------------------------------------------------
# Used to sign JWTs. Generate a fresh random value per environment:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret-value

# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed browser origins, or a JSON array.
CORS_ORIGINS=*

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Database (Supabase Postgres) -----------------------------------------
# Full connection string from Supabase: Project Settings -> Database ->
# Connection string -> "Transaction" (pooler, port 6543). Prepend the driver
# so SQLAlchemy picks psycopg2.
DATABASE_URL=postgresql+psycopg2://postgres.CHANGE_ME:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --- Supabase -------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase API keys (Publishable / Anon key & Secret / Service Role key)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# --- Photo storage --------------------------------------------------------
# "local"  -> store report photos on local disk (UPLOAD_DIR). Fine locally.
# "supabase" -> store them in a Supabase Storage bucket. REQUIRED in production
#   on hosts with an ephemeral disk (Render free tier, Vercel), or uploads are
#   lost on restart. Needs SUPABASE_URL + SUPABASE_SECRET_KEY set above, and a
#   PUBLIC bucket created in the dashboard (Storage -> New bucket -> Public).
PHOTO_STORAGE_BACKEND=local
SUPABASE_STORAGE_BUCKET=report-photos

# --- Google AI (Gemini) ---------------------------------------------------
# API key from https://aistudio.google.com/apikey. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# --- Google Maps / Geocoding ----------------------------------------------
GOOGLE_MAPS_API_KEY=

# --- Email / SMTP ---------------------------------------------------------
# Powers the password-reset and email-verification messages. Leave SMTP_HOST
# blank to disable email: the auth flows still work (forgot-password still
# returns its generic 200), they just never dispatch a message.
#
# Master switch. Set to false to silence all outbound email even when SMTP is
# configured (handy for local demos).
EMAIL_ENABLED=true

# SMTP relay connection.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Transport security. Use STARTTLS on port 587 (SMTP_USE_TLS=true), OR implicit
# TLS on port 465 (SMTP_USE_SSL=true, SMTP_USE_TLS=false). Do not enable both.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# From address shown to recipients. SMTP_FROM_EMAIL falls back to SMTP_USERNAME,
# and SMTP_FROM_NAME falls back to APP_NAME, when left blank.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# Base URL of the frontend, used to build the links inside emails
# (e.g. {FRONTEND_BASE_URL}/reset-password?token=...). No trailing slash.
FRONTEND_BASE_URL=http://localhost:5173

# Link lifetimes.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48

# --- Gmail quick-start ----------------------------------------------------
# Gmail requires an "App Password" (not your normal password): enable 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USERNAME=you@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   SMTP_FROM_EMAIL=you@gmail.com

# ===========================================================================
# FRONTEND CONFIGURATION (Vite)
# ===========================================================================

# API Base URL for FastAPI Backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Application Name
VITE_APP_NAME="Neighborhood Issue Reporter"

# Default Map Configuration (OpenStreetMap / Leaflet)
VITE_MAP_DEFAULT_LAT=40.7128
VITE_MAP_DEFAULT_LNG=-74.0060
VITE_MAP_DEFAULT_ZOOM=13

# Fallback adapter. When true (or when VITE_API_BASE_URL is unset), a failed
# backend call silently falls back to localStorage demo data. Keep this FALSE
# when a real backend is running so genuine errors surface instead of being
# masked. Set true only for a backend-less preview/demo build.
VITE_ENABLE_MOCK_FALLBACK=false
